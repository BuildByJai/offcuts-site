            "text": "A huge heap of the railway’s coal, with a whitewashed line round the top."
          },
          {
            "object": "note",
            "label": "Peter’s bag",
            "text": "An old carpenter’s bag. Peter says he is mining coal from the “middle” of the heap, so it doesn’t count."
          },
          {
            "object": "lamp",
            "label": "The Station Master",
            "text": "The Station Master has noticed the heap getting smaller…"
          }
        ],
        "solve": {
          "object": "sign",
          "label": "The answer",
          "type": "choice",
          "prompt": "Was it right for Peter to take the coal?",
          "options": [
            "No — it was the railway’s coal, so it was stealing, even from the middle",
            "Yes — the heap was huge",
            "Yes — he only took a little"
          ],
          "answer": 0,
          "hint": "Whose coal was it?"
