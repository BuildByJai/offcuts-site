{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offcuts-site",
  "main": "src/api.js",
  "compatibility_date": "2026-07-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "FANTASY_SQUADS",
      "id": "49e9459ede7a4e888faebea4f6ad4d35"
    },
    {
      "binding": "FANTASY_PLAYER_STATS",
      "id": "abbbbf970a31488a8c7e4e6483ceedda"
    },
    {
      "binding": "FANTASY_LEADERBOARD_CACHE",
      "id": "4957f81e28784db097635870c5055b29"
    },
    {
      "binding": "POST_MATCH_CACHE",
      "id": "1c9df72099cb484190a70d2417a16481"
    }
  ]
  // ANTHROPIC_API_KEY is set as a Worker secret (`wrangler secret put
  // ANTHROPIC_API_KEY`) for the Post-Match Moments tool — not stored here.
  // Optional override, also via secret/env if ever needed:
  //   - ANTHROPIC_MODEL (defaults to claude-opus-5)
  //
  // v2 note: this tool no longer pulls from API-Football — input is now a
  // pasted match report (see tools/post-match-moments/). API_FOOTBALL_KEY
  // is still set as a secret from the earlier version but is unused; no
  // need to remove it. POST_MATCH_CACHE is repurposed to cache generated
  // moments by a hash of the pasted report instead of API fixture data.
}
