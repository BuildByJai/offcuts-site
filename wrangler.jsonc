{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "offcuts-site",
  "main": "src/api.js",
  "compatibility_date": "2026-07-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "FANTASY_SQUADS",
      "id": "49e9459ede7a4e888faebea4f6ad4d35"
    },
    {
      "binding": "FANTASY_PLAYER_STATS",
      "id": "abbbbf970a31488a8c7e4e6483ceedda"
    },
    {
      "binding": "FANTASY_LEADERBOARD_CACHE",
      "id": "4957f81e28784db097635870c5055b29"
    }
    // MANUAL SETUP NEEDED — Post-Match Moments tool (tools/post-match-moments/):
    // create a KV namespace in the Cloudflare dashboard, bind it here as
    // { "binding": "POST_MATCH_CACHE", "id": "<real id>" }, and set these
    // Worker secrets (`wrangler secret put <NAME>`):
    //   - API_FOOTBALL_KEY  (reuse the Golden Boot Tracker key if still
    //     valid — no such tool exists in this repo/history though, so
    //     confirm a live key before relying on it)
    //   - API_FOOTBALL_HOST (optional; defaults to v3.football.api-sports.io —
    //     only set this to api-football-v1.p.rapidapi.com if the reused
    //     account is a RapidAPI subscription instead)
    //   - ANTHROPIC_API_KEY
    //   - ANTHROPIC_MODEL   (optional; defaults to claude-opus-5)
    // Placeholder KV IDs break bindings, so this is left out until a real
    // namespace exists — see src/lib/post-match-moments/api-football.js.
  ]
}
